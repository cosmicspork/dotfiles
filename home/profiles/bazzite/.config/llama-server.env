# Arguments for llama-server, consumed by llama-server.service.
# Single logical line, word-split by systemd. Restart after editing:
#   systemctl --user restart llama-server.service
#
# Bound to 127.0.0.1 on purpose: llama-server has no authentication.
# Model weights are cached under ~/.cache/llama.cpp (LLAMA_CACHE in the unit).
# --jinja is required for OpenAI-style tool calling; without it the server
# returns 500 on any request carrying a tools parameter.
LLAMA_SERVER_ARGS=-hf unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_XL --alias qwen3-coder --host 127.0.0.1 --port 8080 -ngl 99 -c 65536 -fa on --jinja --temp 0.7 --top-p 0.8 --top-k 20 --repeat-penalty 1.05

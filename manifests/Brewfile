# Shared Homebrew formulae — installed on every host with Homebrew (macOS and
# Bazzite, which ships brew as the blessed path for CLI tools). Profile-specific
# casks live in manifests/<profile>/Brewfile.
tap "fluxcd/tap"
# Simple, modern, secure file encryption
brew "age"
# Improved shell history for zsh, bash, fish and nushell
brew "atuin"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Incredibly fast JavaScript runtime, bundler, test runner, and package manager
brew "bun"
# General-purpose scripting language
brew "php"
# Dependency Manager for PHP
brew "composer"
# Reference implementation for the Development Containers specification
brew "devcontainer"
# Load/unload environment variables based on $PWD
brew "direnv"
# Command-line tool for DigitalOcean
brew "doctl"
# Perl lib for reading and writing EXIF metadata
brew "exiftool"
# Modern, maintained replacement for ls
brew "eza"
# Simple, fast and user-friendly alternative to find
brew "fd"
# GitHub command-line tool
brew "gh"
# Syntax-highlighting pager for git and diff output
brew "git-delta"
# Open-source GitLab command-line tool
brew "glab"
# Post-modern modal text editor
brew "helix"
# Kubernetes package manager
brew "helm"
# Kubernetes command-line interface
brew "kubernetes-cli"
# Media player based on MPlayer and mplayer2
brew "mpv"
# Search tool like grep and The Silver Searcher
